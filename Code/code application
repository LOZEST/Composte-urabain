        headers: { Accept: "application/json" },
      });
      const kg = Number(data?.weightKg ?? data?.weight_kg ?? 0);
      const raw = Number(data?.raw ?? 0);
      setLiveWeightKg(Number.isFinite(kg) ? kg : 0);
      setWeightRaw(Number.isFinite(raw) ? raw : 0);
      setWasteKg(Number.isFinite(kg) ? String(kg.toFixed(3)) : "0");
      setCardConnected(true);
      return true;
    } catch {
      try {
        const fallback = await apiRequest(cardIp, "/status", { method: "GET" });
        const kg = Number(fallback?.weightKg ?? fallback?.weight_kg ?? 0);
        const raw = Number(fallback?.raw ?? 0);
        setLiveWeightKg(Number.isFinite(kg) ? kg : 0);
        setWeightRaw(Number.isFinite(raw) ? raw : 0);
        if (Number.isFinite(kg)) setWasteKg(String(kg.toFixed(3)));
        setCardConnected(true);
        return true;
      } catch {
        try {
          const gasData = await apiRequest(cardIp, "/data", { method: "GET" });
          const hasGasValue = [gasData?.mq2_1, gasData?.mq2_2, gasData?.mq2_3, gasData?.mq2_4].some((v) => Number.isFinite(Number(v)));
          setCardConnected(!!hasGasValue);
          return !!hasGasValue;
        } catch {
          try {
            await withTimeout(fetch(String(cardIp || '').replace(/\/+$/, '')), 5000);
            setCardConnected(true);
          } catch {
            setCardConnected(false);
          }
          return false;
        }
      }
    } finally {
      if (showLoader) setWeightLoading(false);
    }
  }

