            for (const comp of incomingComposters) {
              if (!next[comp.id]) next[comp.id] = {};
              const localComp = composters.find((c) => c.id === comp.id) || comp;
              const vats = Array.isArray(comp.vats) ? comp.vats : localComp?.vats || [];
              for (const vat of vats.slice(0, 4)) {
                const normalized = normalizeIncomingSensor(vat.sensor || vat, vat);
                const prevVat = ensureVatStatsShape(prev?.[comp.id]?.[vat.id] || {});
                const weightKg = normalized.weightKg > 0 ? normalized.weightKg : prevVat.weightKg;
                next[comp.id][vat.id] = ensureVatStatsShape({
                  ...prevVat,
                  weightKg,
                  compostReadyKg: normalized.compostReadyKg > 0 ? normalized.compostReadyKg : prevVat.compostReadyKg,
                  fillPct: normalized.fillPct,
                  cycleStartedAt: normalized.cycleStartedAt || prevVat.cycleStartedAt,
                  updatedAt: normalized.updatedAt || new Date().toISOString(),
                });
              }
            }
            return next;
          });
        }
      } catch {
        // on essaie ensuite la route simple /data pour les 4 MQ-2
      }

      if (!sensorsLoaded) {
        try {
          const gasData = await apiRequest(cardIp, "/data", { method: "GET" });
          if (!mounted) return;

          const sensorMap = {
            v1: {
              tempC: Number(gasData?.temp1),
              humidity: Number(gasData?.hum1),
              gasPpm: Number(gasData?.mq2_1),
            },
            v2: {
