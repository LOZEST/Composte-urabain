/* =========================
   LIVE SENSOR (SIMU)
========================= */
function clamp01(n) {
  if (!Number.isFinite(n)) return 0;
  return Math.max(0, Math.min(1, n));
}
function clampPct(n) {
  if (!Number.isFinite(n)) return 0;
  return Math.max(0, Math.min(100, n));
}
function approxMove(current, target, speed = 0.12) {
  // rapproche doucement current vers target
  const c = Number(current);
  const t = Number(target);
  if (!Number.isFinite(c) || !Number.isFinite(t)) return t;
  return c + (t - c) * speed;
}

function fanStateFromConfig(cfg, tempC, nowMs) {
  const mode = cfg?.fanMode || "OFF";
  const thr = Number(cfg?.fanThresholdTemp ?? 65);
  const intervalH = Math.max(0.25, Number(cfg?.fanIntervalHours ?? 2));
  if (mode === "OFF") return "OFF";
  if (mode === "ON_REG") return tempC >= thr ? "ON" : "OFF";
  const periodMs = intervalH * 3600_000;
  const phase = (nowMs % periodMs) / periodMs;
  return phase < 0.12 ? "ON" : "OFF";
}

const PROCESS_PHASES = ["RAMOLLISSEMENT", "DIGESTION_ACTIVE", "MATURATION"];

function getPhaseDurationDays(modeKey, remoteCfg) {
  return Math.max(0, Number(remoteCfg?.[modeKey]?.durationDays ?? DEFAULT_REMOTE_CONFIG[modeKey]?.durationDays ?? 0));
}
function getTotalCycleDays(remoteCfg) {
  return PROCESS_PHASES.reduce((s, key) => s + getPhaseDurationDays(key, remoteCfg), 0);
}
function getCurrentProcessMode(cycleStartedAt, remoteCfg) {
  if (!cycleStartedAt) return "REMPLISSAGE";
  const elapsedDays = Math.max(0, (Date.now() - new Date(cycleStartedAt).getTime()) / 86400000);
  let cursor = 0;
  for (const key of PROCESS_PHASES) {
    cursor += getPhaseDurationDays(key, remoteCfg);
    if (elapsedDays < cursor) return key;
  }
  return "MATURATION";
}
function getRemainingDaysForMode(cycleStartedAt, remoteCfg) {
  if (!cycleStartedAt) return null;
  const elapsedDays = Math.max(0, (Date.now() - new Date(cycleStartedAt).getTime()) / 86400000);
  let cursor = 0;
  for (const key of PROCESS_PHASES) {
    cursor += getPhaseDurationDays(key, remoteCfg);
    if (elapsedDays < cursor) return Math.max(0, cursor - elapsedDays);
  }
  return 0;
}
function isCycleFinished(cycleStartedAt, remoteCfg) {
  if (!cycleStartedAt) return false;
  const elapsedDays = Math.max(0, (Date.now() - new Date(cycleStartedAt).getTime()) / 86400000);
  return elapsedDays >= getTotalCycleDays(remoteCfg);
}
function getPhysicalActionLabel(modeKey, sensorState) {
  if (sensorState?.transferActive) return "Transfert en cours vers la cuve 4 de stockage";
  if (modeKey === "REMPLISSAGE") return "En attente du lancement du cycle";
  if (modeKey === "RAMOLLISSEMENT") return sensorState?.mixOn ? "Mélange du compost en cours" : "Ramollissement en cours";
  if (modeKey === "DIGESTION_ACTIVE") return sensorState?.mixOn ? "Mélange du compost en cours" : "Digestion active en cours";
  if (modeKey === "MATURATION") return "Maturation en cours";
  return "Stockage du compost final";
}


