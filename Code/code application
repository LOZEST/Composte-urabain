  useEffect(() => {
    if (!composters.length) return;
    const tick = setInterval(() => {
      const nowIso = new Date().toISOString();
      setVatStats((prev) => {
        let changed = false;
        const next = { ...prev };
        for (const comp of composters) {
          const compId = comp.id;
          if (!next[compId]) next[compId] = {};
          const storage = ensureVatStatsShape(next[compId]?.v4 || {});
          let storageWeightKg = storage.weightKg;
          let storageChanged = false;

          for (const vat of (comp.vats || []).slice(0, 3)) {
            const current = ensureVatStatsShape(next[compId]?.[vat.id] || {});
            const vatCfg = vatConfigMap?.[compId]?.[vat.id] || defaultVatConfigForMode(vat.mode || cycleModeFromVatId(vat.id));
            const currentMode = vat.mode || cycleModeFromVatId(vat.id);
            const shouldAutoStart = currentMode === "REMPLISSAGE" && current.weightKg > 0 && current.fillPct >= Number(vatCfg.fillStartThresholdPct ?? 100) && !!vatCfg.autoStartWhenFull;
            if (!current.cycleStartedAt && shouldAutoStart) {
              next[compId][vat.id] = ensureVatStatsShape({
                ...current,
                cycleStartedAt: nowIso,
                updatedAt: nowIso,
              });
              changed = true;
              continue;
            }

            if (current.cycleStartedAt && isCycleFinished(current.cycleStartedAt, remoteConfig)) {
              const transferKg = Math.max(0, Number(current.compostReadyKg || current.weightKg * DEFAULT_TRANSFER_RATIO));
              if (transferKg > 0) {
                storageWeightKg += transferKg;
                storageChanged = true;
              }
              next[compId][vat.id] = ensureVatStatsShape({
                weightKg: 0,
                compostReadyKg: 0,
                fillPct: 0,
                cycleStartedAt: null,
                lastTransferAt: nowIso,
                updatedAt: nowIso,
              });
              changed = true;
            }
          }

          if (storageChanged) {
            next[compId].v4 = ensureVatStatsShape({
              ...storage,
              weightKg: storageWeightKg,
              compostReadyKg: storageWeightKg,
              fillPct: computeFillPctFromKg(storageWeightKg, "v4"),
              updatedAt: nowIso,
            });
            changed = true;
          }
        }
        return changed ? next : prev;
      });
    }, 5000);
    return () => clearInterval(tick);
  }, [composters, vatConfigMap, remoteConfig]);

  useEffect(() => {
    if (!composters.length) return;
    setLiveSensors((prev) => {
      const next = { ...prev };
      let changed = false;
      for (const comp of composters) {
        if (!next[comp.id]) next[comp.id] = {};
        for (const vat of (comp.vats || []).slice(0, 4)) {
          const stats = ensureVatStatsShape(vatStats?.[comp.id]?.[vat.id] || {});
          const currentMode = vat.id === "v4" ? "STOCKAGE" : (stats.cycleStartedAt ? getCurrentProcessMode(stats.cycleStartedAt, remoteConfig) : (vat.mode || "REMPLISSAGE"));
          const vatCfg = vatConfigMap?.[comp.id]?.[vat.id] || defaultVatConfigForMode(currentMode);
          const modeForTargets = defaultVatConfigForMode(currentMode);
          const currentSensor = next[comp.id][vat.id] || defaultSensorStateFromVat(vat, vatCfg);
          const remainingDays = vat.id === "v4" ? null : (stats.cycleStartedAt ? getRemainingDaysForMode(stats.cycleStartedAt, remoteConfig) : null);
          const patch = {
            ...currentSensor,
            weightKg: stats.weightKg,
            compostReadyKg: stats.compostReadyKg,
            fillPct: computeFillPctFromKg(stats.weightKg, vat.id),
            currentMode,
            cycleStartedAt: stats.cycleStartedAt,
            remainingDays,
            updatedAt: stats.updatedAt || currentSensor.updatedAt || new Date().toISOString(),
            action: vat.id === "v4"
              ? `Stockage disponible : ${stats.weightKg.toFixed(2)} kg`
              : getPhysicalActionLabel(currentMode, {
                  ...currentSensor,
                  transferActive: !!stats.lastTransferAt && (Date.now() - new Date(stats.lastTransferAt).getTime()) < 60000,
                  mixOn: !!vatCfg.mixImmediate,
                }),
            fan: currentSensor.sensorErrors?.fan ? null : (currentSensor.fan || fanStateFromConfig(modeForTargets, currentSensor.tempC, Date.now())),
            online: currentSensor.online,
            sensorErrors: {
              ...(currentSensor.sensorErrors || {}),
              fan: !!currentSensor.sensorErrors?.fan,
            },
          };
          const currentJson = JSON.stringify(currentSensor);
          const patchJson = JSON.stringify(patch);
          if (currentJson !== patchJson) {
            next[comp.id][vat.id] = patch;
            changed = true;
          }
        }
      }
      return changed ? next : prev;
    });
  }, [vatStats, composters, vatConfigMap, remoteConfig]);

  useEffect(() => {
    if (!composters.length) return;
    setFanRuntimeMap((prev) => {
      let changed = false;
      const next = { ...prev };
      for (const comp of composters) {
        const compId = comp.id;
        const compFans = fanConfigMap?.[compId] || defaultFanConfig();
        if (!next[compId]) next[compId] = ensureFanRuntime({});
        for (const fan of FAN_LIST) {
          const cfg = compFans[fan.id] || defaultFanConfig()[fan.id];
          const current = next[compId]?.[fan.id] || ensureFanRuntime({})[fan.id];
          let targetState = current.state || "OFF";
          let reason = "Commande manuelle";
          if (cfg.mode === "ON") {
            targetState = "ON";
            reason = "Commande manuelle ON";
          } else if (cfg.mode === "OFF") {
            targetState = "OFF";
            reason = "Commande manuelle OFF";
          } else {
            const decision = getFanAutoDecision(cfg, liveSensors?.[compId]?.[cfg.vatId] || {});
            targetState = decision.state;
            reason = decision.reason;
          }
          if (current.state !== targetState || current.lastAutoReason !== reason) {
            next[compId] = {
              ...ensureFanRuntime(next[compId] || {}),
              [fan.id]: {
                ...current,
                state: targetState,
                lastAutoReason: reason,
              },
            };
            changed = true;
          }
        }
      }
      return changed ? next : prev;
    });
  }, [composters, fanConfigMap, liveSensors]);

