  const hasTemp = Number.isFinite(tempC);
  const hasHumidity = Number.isFinite(humidity);
  const hasGas = Number.isFinite(gasPpm);

  const reasonsOn = [];
  if (hasTemp && tempC >= Number(cfg?.tempOnC ?? 35)) reasonsOn.push(`température ${tempC.toFixed(1)}°C`);
  if (hasHumidity && humidity >= Number(cfg?.humidityOnPct ?? 80)) reasonsOn.push(`humidité ${humidity.toFixed(0)}%`);
  if (hasGas && gasPpm >= Number(cfg?.gasOnPpm ?? 650)) reasonsOn.push(`gaz ${gasPpm.toFixed(0)} ppm`);

  if (reasonsOn.length) return { state: "ON", reason: `AUTO ON : ${reasonsOn.join(" + ")}` };

  const allKnownValuesSafe =
    (!hasTemp || tempC <= Number(cfg?.tempOffC ?? 30)) &&
    (!hasHumidity || humidity <= Number(cfg?.humidityOffPct ?? 70)) &&
    (!hasGas || gasPpm <= Number(cfg?.gasOffPpm ?? 450));

  if (allKnownValuesSafe) return { state: "OFF", reason: "AUTO OFF : valeurs sous les seuils bas" };
  return { state: "OFF", reason: "AUTO attente : hystérésis entre seuil ON et OFF" };
}

