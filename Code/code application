            },
            v4: {
              tempC: Number(gasData?.temp4),
              humidity: Number(gasData?.hum4),
              gasPpm: Number(gasData?.mq2_4),
            },
          };

          const validTemp = (v) => Number.isFinite(v) && v >= -20 && v <= 90;
          const validHum = (v) => Number.isFinite(v) && v >= 0 && v <= 100;
          const validGas = (v) => Number.isFinite(v) && v >= 0 && v <= 10000;

          setLiveSensors((prev) => {
            const next = { ...prev };
            for (const comp of composters) {
              if (!next[comp.id]) next[comp.id] = {};
              for (const vat of (comp.vats || []).slice(0, 4)) {
                const values = sensorMap[vat.id] || {};
                const current = next[comp.id][vat.id] || defaultSensorStateFromVat(vat, {});
                const hasTemp = validTemp(values.tempC);
                const hasHum = validHum(values.humidity);
                const hasGas = validGas(values.gasPpm);

                next[comp.id][vat.id] = {
                  ...current,
                  tempC: hasTemp ? values.tempC : null,
                  humidity: hasHum ? values.humidity : null,
