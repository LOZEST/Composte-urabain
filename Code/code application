function pickNumericSensorValue(sensor, keys = []) {
  for (const key of keys) {
    const raw = sensor?.[key];
    if (raw == null || raw === "") continue;
    const parsed = Number(raw);
    if (Number.isFinite(parsed)) return parsed;
  }
  return null;
}
function pickStringSensorValue(sensor, keys = []) {
  for (const key of keys) {
    const raw = sensor?.[key];
    if (raw == null) continue;
    const str = String(raw).trim();
    if (str) return str;
  }
  return null;
}
function normalizeIncomingSensor(sensor = {}, vat = {}) {
  const weightKg = Math.max(0, Number(sensor.weightKg ?? sensor.weight_kg ?? sensor.massKg ?? sensor.mass_kg ?? 0));
  const explicitFill = sensor.fillPct ?? sensor.fill_pct ?? sensor.fillLevel;
  const tempC = pickNumericSensorValue(sensor, ["tempC", "temperature"]);
  const humidity = pickNumericSensorValue(sensor, ["humidity"]);
  const airQuality = pickNumericSensorValue(sensor, ["airQuality", "air_quality"]);
  const co2Ppm = pickNumericSensorValue(sensor, ["co2Ppm", "co2", "co2_ppm"]);
  const gasPpm = pickNumericSensorValue(sensor, ["gasPpm", "gas", "gas_ppm"]);
  const fan = pickStringSensorValue(sensor, ["fan", "fanState"]);
  return {
    tempC,
    humidity,
    airQuality,
    co2Ppm,
    gasPpm,
    weightKg,
    compostReadyKg: Math.max(0, Number(sensor.compostReadyKg ?? sensor.compost_ready_kg ?? 0)),
    fillPct: explicitFill == null ? computeFillPctFromKg(weightKg, vat.id) : clampPct(Number(explicitFill)),
    fan,
    action: String(sensor.action ?? "Données reçues depuis la carte"),
    updatedAt: sensor.updatedAt || sensor.updated_at || new Date().toISOString(),
    currentMode: sensor.currentMode || sensor.mode || vat.mode || "REMPLISSAGE",
    cycleStartedAt: sensor.cycleStartedAt || sensor.cycle_started_at || null,
    transferActive: !!(sensor.transferActive ?? sensor.transfer_active),
    mixOn: !!(sensor.mixOn ?? sensor.mix_on),
    remainingDays: sensor.remainingDays == null ? null : Number(sensor.remainingDays),
    online: sensor.online !== false,
    sensorErrors: {
      tempC: tempC == null,
      humidity: humidity == null,
      airQuality: airQuality == null,
      co2Ppm: co2Ppm == null,
      gasPpm: gasPpm == null,
      fan: fan == null,
    },
  };
}
