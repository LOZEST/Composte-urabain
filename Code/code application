function getVatCapacityKg(vatId) {
  return vatId === "v4" ? STORAGE_VAT_CAPACITY_KG : DEFAULT_VAT_CAPACITY_KG;
}
function toIsoOrNow(value) {
  const d = value ? new Date(value) : new Date();
  return Number.isNaN(d.getTime()) ? new Date().toISOString() : d.toISOString();
}
function computeFillPctFromKg(weightKg, vatId) {
  const cap = getVatCapacityKg(vatId);
  if (!Number.isFinite(Number(weightKg)) || cap <= 0) return 0;
  return clampPct((Number(weightKg) / cap) * 100);
}
function ensureVatStatsShape(vat = {}) {
