  async function onCreateDeposit() {
    if (!selectedComposter) {
      Alert.alert("Erreur", "Sélectionne un composteur.");
      return;
    }
    const kg = Number(String(wasteKg).replace(",", "."));
    if (!cardConnected) {
      Alert.alert("Carte non connectée", "Connecte la carte pour récupérer automatiquement le poids du capteur.");
      return;
    }
    if (!Number.isFinite(kg) || kg <= 0) {
      Alert.alert("Entrée invalide", "Aucun poids valide reçu depuis le capteur de force.");
      return;
    }
    const compostKg = Math.round(kg * COMPOST_RATIO * 100) / 100;
    const now = new Date();
    const maturesAt = addDays(now, MATURATION_DAYS);
    const d = {
      id: uid("dep"),
      createdAt: now.toISOString(),
      maturesAt: maturesAt.toISOString(),
      wasteKg: kg,
      compostKg,
      note: note.trim(),
      composterId: selectedComposter.id,
      composterName: selectedComposter.name,
    };

    try {
      await apiRequest(cardIp, "/api/deposit", {
        method: "POST",
        body: JSON.stringify({
          composterId: selectedComposter.id,
          wasteKg: kg,
          note: note.trim(),
          userId: currentUserId,
        }),
      });
    } catch {
      // conserve le dépôt local même si la carte ne répond pas
    }

    setDeposits((prev) => [d, ...prev]);
    setVatStats((prev) => {
      const next = { ...prev };
      const compId = selectedComposter.id;
      if (!next[compId]) next[compId] = {};
      const fillVatIds = ["v1", "v2", "v3"];
      let targetVatId = fillVatIds.find((vatId) => {
        const vat = ensureVatStatsShape(next[compId]?.[vatId] || {});
        return vat.fillPct < 100 || vat.weightKg <= 0;
      }) || "v3";
      const current = ensureVatStatsShape(next[compId]?.[targetVatId] || {});
      const nextWeightKg = current.weightKg + kg;
      next[compId][targetVatId] = ensureVatStatsShape({
        ...current,
        weightKg: nextWeightKg,
        compostReadyKg: Math.max(current.compostReadyKg, nextWeightKg * DEFAULT_TRANSFER_RATIO),
        fillPct: computeFillPctFromKg(nextWeightKg, targetVatId),
        updatedAt: new Date().toISOString(),
      });
      return next;
    });
    relayOffDelayForDeposit();
    setWasteKg("0");
    setLiveWeightKg(0);
    setWeightRaw(0);
    setNote("");
    setScreen("MAIN");
    setActiveTab("DEPOTS");
  }

